# ───────── Frontend ─────────
# URL FastAPI бэкенда. На single-container деплое можно оставить пустым,
# тогда фронт будет ходить на тот же origin.
VITE_API_URL=http://localhost:8000

# ───────── Backend (FastAPI) ─────────
# PostgreSQL (рекомендованный production-вариант).
# Поднять локально через Docker:
#   docker run --name bioauth-pg -e POSTGRES_PASSWORD=123 -e POSTGRES_DB=dna -p 5432:5432 -d postgres:16
DATABASE_URL=postgresql+psycopg://postgres:123@localhost:5432/dna

# SQLite (быстрая локальная разработка без поднятия Postgres):
# DATABASE_URL=sqlite:///./bioauth.db

# ───────── Railway deployment ─────────
# When deploying on Railway, set DATABASE_URL to the PRIVATE network URL so the
# app connects through Railway's internal network instead of the public internet.
# In the Railway dashboard: Variables → add DATABASE_URL with the value from
# the Postgres service's "Private URL" (not "Public URL" / DATABASE_PUBLIC_URL).
#
# Private URL format:
#   DATABASE_URL=postgresql+psycopg://<user>:<password>@Postgres.railway.internal:5432/<db>
#
# WARNING: Do NOT set DATABASE_URL to the value of DATABASE_PUBLIC_URL.
# The public TCP proxy (e.g. 66.33.22.226:11187) routes traffic over the internet
# and can cause "password authentication failed" errors.

# Список origin-ов, с которых разрешены CORS-запросы (JSON-массив).
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Лимит попыток /verify в минуту с одного IP+username.
VERIFY_RATE_LIMIT_PER_MINUTE=30
